# API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional API Keys
DEEPSEEK_API_KEY=your-deepseek-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Model Settings
DEFAULT_MODEL=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=2000

# Cost Control
MAX_DAILY_COST_USD=5.0
MAX_TOTAL_COST_USD=50.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ma_cmm.log

# Voice Interface
VOICE_STT_MODEL=large-v3
VOICE_STT_DEVICE=cuda
VOICE_STT_COMPUTE_TYPE=float16
VOICE_TTS_BACKEND=edge              # edge|openai|cosyvoice
VOICE_TTS_VOICE=                    # empty = auto-select by language
VOICE_LANGUAGE=auto                 # auto|zh|en
VOICE_VAD_THRESHOLD=0.5
VOICE_VAD_MIN_SILENCE_MS=600
VOICE_VAD_MIN_SPEECH_MS=250
VOICE_SAMPLE_RATE=16000