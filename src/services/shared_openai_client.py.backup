"""
共享OpenAI客户端管理器
Shared OpenAI Client Manager

避免多个智能体创建重复的客户端连接
"""

import os
import time
from typing import Optional
from openai import AsyncOpenAI
import httpx
import asyncio
from ..utils.config import get_logger, get_env

logger = get_logger(__name__)

class SharedOpenAIClientManager:
    """共享的OpenAI客户端管理器 - 定期刷新连接池，支持UI环境下的event loop变化"""
    
    _instance: Optional['SharedOpenAIClientManager'] = None
    _client: Optional[AsyncOpenAI] = None
    _embedding_client: Optional[AsyncOpenAI] = None
    _chat_http_client: Optional[httpx.AsyncClient] = None  # chat专用httpx客户端
    _embedding_http_client: Optional[httpx.AsyncClient] = None  # embedding专用httpx客户端
    _request_semaphore: Optional[asyncio.Semaphore] = None  # 限制并发请求
    _client_lock = asyncio.Lock()  # 客户端创建锁
    _last_refresh = 0  # 上次刷新时间
    _refresh_interval = 300  # 5分钟刷新一次
    _request_count = 0  # 请求计数
    _error_count = 0  # 连接错误计数
    _last_error_time = 0  # 上次错误时间
    _consecutive_errors = 0  # 连续错误计数
    _last_success_time = 0  # 上次成功时间
    _current_loop_id = None  # 当前事件循环ID，用于检测UI环境下的loop变化
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
        return cls._instance
    
    def _get_current_loop_id(self) -> str:
        """获取当前事件循环的唯一ID"""
        try:
            loop = asyncio.get_running_loop()
            return str(id(loop))
        except RuntimeError:
            return "no_loop"
    
    def _is_loop_changed(self) -> bool:
        """检查事件循环是否已改变（UI环境特有问题）"""
        current_loop_id = self._get_current_loop_id()
        if self._current_loop_id is None:
            self._current_loop_id = current_loop_id
            return False
        
        if current_loop_id != self._current_loop_id:
            logger.info(f"Event loop changed: {self._current_loop_id} -> {current_loop_id}")
            self._current_loop_id = current_loop_id
            return True
        
        return False
    
    def get_chat_client(self) -> AsyncOpenAI:
        """获取对话客户端 - 定期刷新连接池，支持UI环境下的event loop变化"""
        current_time = time.time()
        
        # UI环境特殊检查：事件循环变化时强制刷新
        loop_changed = self._is_loop_changed()
        
        # 激进的连接池健康检查：UI环境下更频繁刷新
        should_refresh = (
            self._client is None or 
            loop_changed or  # UI环境：事件循环变化立即刷新
            current_time - self._last_refresh > 60 or  # UI环境：1分钟刷新（更频繁）
            self._request_count > 30 or  # UI环境：降低请求数阈值
            self._consecutive_errors >= 1 or  # UI环境：1次错误就刷新（更激进）
            (current_time - self._last_success_time > 90 and self._last_success_time > 0)  # UI环境：1.5分钟无成功请求
        )
            
        if should_refresh:
            refresh_reason = []
            if self._client is None:
                refresh_reason.append("初始化")
            if loop_changed:
                refresh_reason.append("事件循环变化")
            if current_time - self._last_refresh > 60:
                refresh_reason.append("时间超时")
            if self._request_count > 30:
                refresh_reason.append("请求数过多")
            if self._consecutive_errors >= 1:
                refresh_reason.append("连续错误")
                
            logger.info(f"UI环境连接池刷新: {', '.join(refresh_reason)} (请求数: {self._request_count})")
            
            # UI环境：先安全关闭旧连接
            if self._chat_http_client is not None:
                try:
                    # 不等待关闭，避免在新事件循环中调用旧loop的资源
                    self._chat_http_client = None
                except Exception as e:
                    logger.debug(f"旧连接清理异常（UI环境正常）: {e}")
            
            # UI环境：极度保守的连接池配置
            self._chat_http_client = httpx.AsyncClient(
                timeout=httpx.Timeout(connect=3.0, read=10.0, write=3.0, pool=1.0),  # UI环境：更短超时
                limits=httpx.Limits(
                    max_keepalive_connections=4,  # UI环境：减少keepalive连接
                    max_connections=8,  # UI环境：减少总连接数
                    keepalive_expiry=15.0  # UI环境：更短keepalive过期
                ),
                http2=False,  # 禁用HTTP/2
                transport=httpx.AsyncHTTPTransport(retries=0)  # UI环境：禁用传输层重试
            )
            self._client = AsyncOpenAI(
                api_key=get_env("OPENAI_API_KEY"),
                timeout=12.0,  # UI环境：更短超时避免UI卡顿
                max_retries=1,  # UI环境：减少重试避免叠加延迟
                http_client=self._chat_http_client
            )
            
            # 重置计数器
            self._last_refresh = current_time
            self._request_count = 0
            self._error_count = 0  # 刷新时重置错误计数
            self._consecutive_errors = 0  # 重置连续错误
            if self._last_success_time == 0:
                self._last_success_time = current_time
            
            # UI环境：更保守的并发控制
            if self._request_semaphore is None or loop_changed:
                self._request_semaphore = asyncio.Semaphore(2)  # UI环境：减少并发降低连接压力
            
            logger.info("创建/刷新UI优化的共享客户端")
        
        # 增加请求计数
        self._request_count += 1
        return self._client
    
    async def get_chat_client_safe(self) -> AsyncOpenAI:
        """线程安全地获取客户端"""
        async with self._client_lock:
            return self.get_chat_client()
    
    def get_request_semaphore(self) -> asyncio.Semaphore:
        """获取请求信号量用于限流"""
        if self._request_semaphore is None:
            self._request_semaphore = asyncio.Semaphore(2)  # UI环境：减少并发
        return self._request_semaphore
    
    def get_stats(self) -> dict:
        """获取连接统计信息"""
        return {
            "request_count": self._request_count,
            "last_refresh": self._last_refresh,
            "time_since_refresh": time.time() - self._last_refresh,
            "next_refresh_in": self._refresh_interval - (time.time() - self._last_refresh)
        }
    
    def get_embedding_client(self) -> AsyncOpenAI:
        """获取embedding客户端 - 与chat客户端统一UI优化配置"""
        current_time = time.time()
        loop_changed = self._is_loop_changed()
        
        # UI环境：与chat客户端一样的刷新策略
        should_refresh = (
            self._embedding_client is None or
            loop_changed or  # UI环境：事件循环变化立即刷新
            current_time - self._last_refresh > 60  # UI环境：1分钟刷新
        )
        
        if should_refresh:
            if self._embedding_client is not None:
                logger.info("UI环境刷新embedding客户端连接池")
                # UI环境：安全清理旧连接
                self._embedding_http_client = None
            
            # UI环境：与chat客户端一致的保守配置
            self._embedding_http_client = httpx.AsyncClient(
                timeout=httpx.Timeout(connect=3.0, read=10.0, write=3.0, pool=1.0),  # UI环境配置
                limits=httpx.Limits(
                    max_keepalive_connections=4,  # UI环境：减少连接
                    max_connections=8, 
                    keepalive_expiry=15.0
                ),
                http2=False,  # 禁用HTTP/2
                transport=httpx.AsyncHTTPTransport(retries=0)  # UI环境：无传输层重试
            )
            
            self._embedding_client = AsyncOpenAI(
                api_key=get_env("OPENAI_API_KEY"),
                timeout=12.0,  # UI环境：与chat一致的较短超时
                max_retries=1,  # UI环境：减少重试
                http_client=self._embedding_http_client  # 使用独立的http客户端
            )
            logger.info("创建/刷新UI优化embedding客户端 (timeout=12s, max_retries=1)")
        return self._embedding_client
    
    async def close(self):
        """关闭所有客户端连接"""
        try:
            if self._chat_http_client:
                await self._chat_http_client.aclose()
                self._chat_http_client = None
        except Exception as e:
            logger.error(f"关闭chat httpx客户端时出错: {e}")
        
        try:
            if self._embedding_http_client:
                await self._embedding_http_client.aclose()
                self._embedding_http_client = None
        except Exception as e:
            logger.error(f"关闭embedding httpx客户端时出错: {e}")
        
        self._client = None
        self._embedding_client = None
    
    async def reset_client_safe(self):
        """安全地重置客户端（异步版本）"""
        async with self._client_lock:
            try:
                if self._chat_http_client:
                    await self._chat_http_client.aclose()
                    self._chat_http_client = None
            except Exception as e:
                logger.error(f"关闭chat httpx客户端失败: {e}")
            
            try:
                if self._embedding_http_client:
                    await self._embedding_http_client.aclose()
                    self._embedding_http_client = None
            except Exception as e:
                logger.error(f"关闭embedding httpx客户端时出错: {e}")
                
            self._client = None
            self._embedding_client = None
            logger.info("客户端已安全重置")
    
    def reset_clients(self):
        """重置客户端连接，强制创建新连接 - UI环境优化"""
        # UI环境：更彻底的重置，包括错误计数和事件循环状态
        self._client = None
        self._embedding_client = None
        self._chat_http_client = None
        self._embedding_http_client = None
        self._request_semaphore = None  # 重置信号量，新事件循环中重建
        
        # 重置错误状态，给新连接一个清洁的开始
        self._consecutive_errors = 0
        self._error_count = 0
        self._request_count = 0
        self._current_loop_id = None  # 清空事件循环ID，让系统重新检测
        
        # 强制下次请求立即刷新
        self._last_refresh = 0
        
        logger.info("UI环境客户端已彻底重置（包括错误状态和事件循环状态）")
    
    def report_connection_error(self):
        """报告连接错误，用于智能重置决策"""
        current_time = time.time()
        self._error_count += 1
        self._consecutive_errors += 1
        self._last_error_time = current_time
        logger.warning(f"连接错误报告: 总计{self._error_count}, 连续{self._consecutive_errors}")
        
        # 连续错误过多时立即触发刷新
        if self._consecutive_errors >= 3:
            logger.error("连续错误过多，将在下次请求时强制刷新连接池")
    
    def report_connection_success(self):
        """报告连接成功，重置错误计数"""
        current_time = time.time()
        self._consecutive_errors = 0  # 重置连续错误计数
        self._last_success_time = current_time
        logger.debug(f"连接成功，重置连续错误计数")

# 全局单例实例
shared_client_manager = SharedOpenAIClientManager()